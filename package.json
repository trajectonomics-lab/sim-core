{
	"name": "@trajectonomics/sim-core",
	"version": "0.0.0-development",
	"description": "Pure, deterministic personal-finance projection engine",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trajectonomics-lab/sim-core.git"
	},
	"type": "module",
	"sideEffects": false,
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=20.0.0"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
		"lint": "biome ci --colors=off --error-on-warnings .",
		"format": "biome check --write .",
		"check": "bun run lint && bun run typecheck && bun test && bun run build && bun run parity && bun run lint:package",
		"parity": "node scripts/parity-check.mjs",
		"parity:update": "bun scripts/parity-update.ts && biome format --write parity/cases.json",
		"lint:package": "publint --strict && attw --pack . --profile node16"
	},
	"peerDependencies": {
		"@trajectonomics/tax": ">=0.0.0"
	},
	"peerDependenciesMeta": {
		"@trajectonomics/tax": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "2.6.3",
		"@types/bun": "^1.4.4",
		"publint": "^0.3.25",
		"tsdown": "^0.23.2",
		"typescript": "^7.0.2"
	}
}
