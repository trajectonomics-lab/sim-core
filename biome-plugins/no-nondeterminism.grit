language js

or {
	`Math.pow($args)`,
	`Math.exp($args)`,
	`Math.expm1($args)`,
	`Math.log($args)`,
	`Math.log1p($args)`,
	`Math.log2($args)`,
	`Math.log10($args)`,
	`Math.random($args)`,
	`Date.$member`,
	`new Date($args)`
} as $call where {
	register_diagnostic(span=$call, message="Nondeterministic API: Math.pow/exp/log/random differ between V8 and JavaScriptCore, and Date reads the wall clock. Use BigInt integer arithmetic and the pure calendar helpers (ADR 0001).", severity="error")
}
